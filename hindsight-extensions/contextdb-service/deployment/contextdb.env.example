# ContextDB-specific settings; supplement the native Hindsight template.
# Deployment scripts generate the runtime configuration from intent.example.json.

# Inject before launching API/Worker to prevent accidental .env overrides.
# Do not rely on automatic .env loading to disable that loading itself.
PYTHON_DOTENV_DISABLED=1

# Enable workspace, user and API Key management in the UI.
# Requires HINDSIGHT_CP_ACCESS_KEY (UI password) and an active operator-admin
# HINDSIGHT_CP_DATAPLANE_API_KEY configured on the UI server.
HINDSIGHT_CP_CONTEXTDB_ENABLED=true

# Team UI authentication also requires an explicit public browser origin and a
# private writable absolute session directory. CONTEXTBASE_CP_* takes precedence.
HINDSIGHT_CP_AUTH_MODE=local
HINDSIGHT_CP_PUBLIC_ORIGIN=http://127.0.0.1:9999
HINDSIGHT_CP_SESSION_DIR=/var/lib/contextdb/ui-sessions
