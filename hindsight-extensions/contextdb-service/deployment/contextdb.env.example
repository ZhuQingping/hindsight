# ContextDB-specific settings; supplement the native Hindsight template.
# Deployment scripts generate the runtime configuration from intent.example.json.

# Inject before launching API/Worker to prevent accidental .env overrides.
# Do not rely on automatic .env loading to disable that loading itself.
PYTHON_DOTENV_DISABLED=1

# Enable workspace, user and API Key management in the UI.
# Requires HINDSIGHT_CP_ACCESS_KEY (UI password) and an active operator-admin
# HINDSIGHT_CP_DATAPLANE_API_KEY configured on the UI server.
HINDSIGHT_CP_CONTEXTDB_ENABLED=true

# Team UI authentication also requires an explicit public browser origin and a
# private writable absolute session directory. CONTEXTBASE_CP_* takes precedence.
HINDSIGHT_CP_AUTH_MODE=local
HINDSIGHT_CP_PUBLIC_ORIGIN=http://127.0.0.1:9999
HINDSIGHT_CP_SESSION_DIR=/var/lib/contextdb/ui-sessions

# Customer connection page: HTTPS addresses reachable from customer machines.
# Never reuse the internal DATAPLANE_API_URL or DATAPLANE_API_KEY here.
# Missing/invalid values hide the corresponding commands instead of using localhost.
# The MCP URL is independent; {bank_id} is URL-encoded for the selected workspace.
# A shared multi-bank MCP endpoint can instead use the generated X-Bank-Id header.
# CONTEXTBASE_CP_PUBLIC_API_URL=https://api.example.com
# CONTEXTBASE_CP_PUBLIC_MCP_URL=https://mcp.example.com/mcp/{bank_id}/
# Publish the newly built, versioned client tgz to OBS/CDN before setting this URL.
# CONTEXTBASE_CP_CODING_AGENTS_PACKAGE_URL=https://downloads.example.com/contextbase-coding-agents-VERSION.tgz
# Independent client packages. Use the actual install file, not an Actions artifact ZIP.
# CONTEXTBASE_CP_OPENCLAW_PACKAGE_URL=https://downloads.example.com/contextbase-openclaw-VERSION.tgz
# CONTEXTBASE_CP_HERMES_PACKAGE_URL=https://downloads.example.com/hermes-plugin-contextbase-VERSION.zip
# CONTEXTBASE_CP_PYTHON_SDK_PACKAGE_URL=https://downloads.example.com/contextbase_client-VERSION-py3-none-any.whl
# CONTEXTBASE_CP_NODE_SDK_PACKAGE_URL=https://downloads.example.com/contextbase-client-VERSION.tgz
