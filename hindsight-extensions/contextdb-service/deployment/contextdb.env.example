# ContextDB-specific settings; supplement the native Hindsight template.
# Deployment scripts generate the runtime configuration from intent.example.json.
# Start with ../docs/deployment.md for the complete operator deployment path.
# This file is reference material, not a complete or automatically loaded .env.
# Edit the intent for supported inputs; render writes api.env and ui.env.
# Runtime secrets and public-prefix aliases have their own precedence; see the guide.

# Inject before launching API/Worker to prevent accidental .env overrides.
# Do not rely on automatic .env loading to disable that loading itself.
PYTHON_DOTENV_DISABLED=1

# Opt in on API/Worker; the UI reads this capability from the plugin.
# Restart API and UI after changes. Disabling retains existing statistics.
CONTEXTDB_RECALL_USAGE_ENABLED=false

# Enable workspace, user and API Key management in the UI.
# Requires HINDSIGHT_CP_ACCESS_KEY (UI password) and an active operator-admin
# HINDSIGHT_CP_DATAPLANE_API_KEY configured on the UI server.
HINDSIGHT_CP_CONTEXTDB_ENABLED=true

# Team UI authentication also requires an explicit public browser origin and a
# private writable absolute session directory. CONTEXTBASE_CP_* takes precedence.
HINDSIGHT_CP_AUTH_MODE=local
HINDSIGHT_CP_PUBLIC_ORIGIN=http://127.0.0.1:9999
HINDSIGHT_CP_SESSION_DIR=/var/lib/contextdb/ui-sessions

# Customer connection page: HTTPS addresses reachable from customer machines.
# Never reuse the internal DATAPLANE_API_URL or DATAPLANE_API_KEY here.
# Missing/invalid values hide the corresponding commands instead of using localhost.
# The MCP URL is independent; {bank_id} is URL-encoded for the selected workspace.
# A shared multi-bank MCP endpoint can instead use the generated X-Bank-Id header.
# CONTEXTBASE_CP_PUBLIC_API_URL=https://api.example.com
# CONTEXTBASE_CP_PUBLIC_MCP_URL=https://mcp.example.com/mcp/{bank_id}/
# Client download settings for the UI. Copy these into the generated ui.env
# after rendering the deployment configuration; restart the UI to apply changes.
# This example is not loaded automatically. Reapply these settings if ui.env is regenerated.
# Replace the release URLs with your own mirror when needed.
# Coding Agents defaults to @huaweicloud/contextbase-coding-agents@latest.
# Optional override to pin a published version:
# CONTEXTBASE_CP_CODING_AGENTS_NPM_PACKAGE=@huaweicloud/contextbase-coding-agents@1.0.0
CONTEXTBASE_CP_OPENCLAW_PACKAGE_URL=https://github.com/RSIXDB/hindsight/releases/download/contextbase-clients-v0.1.0/contextbase-openclaw-1.0.0.tgz
CONTEXTBASE_CP_HERMES_PACKAGE_URL=https://github.com/RSIXDB/hindsight/releases/download/contextbase-clients-v0.1.0/hermes-plugin-contextbase-1.2.2.zip
CONTEXTBASE_CP_PYTHON_SDK_PACKAGE_URL=https://github.com/RSIXDB/hindsight/releases/download/contextbase-clients-v0.1.0/contextbase_client-1.0.0-py3-none-any.whl
