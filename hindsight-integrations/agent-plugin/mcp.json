{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "contextbase": {
      "type": "streamable-http",
      "url": "${CONTEXTBASE_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${CONTEXTBASE_API_KEY}",
        "X-Bank-Id": "${CONTEXTBASE_BANK_ID}"
      }
    }
  }
}
