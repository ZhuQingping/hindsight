{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agentstratum": {
      "type": "streamable-http",
      "url": "${AGENTSTRATUM_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${AGENTSTRATUM_API_KEY}",
        "X-Bank-Id": "${AGENTSTRATUM_BANK_ID}"
      }
    }
  }
}
