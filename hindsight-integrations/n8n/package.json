{
  "name": "n8n-nodes-contextbase",
  "version": "0.1.4",
  "description": "n8n community nodes for ContextBase - persistent memory for any n8n workflow",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-icons",
    "copy-icons": "mkdir -p dist/nodes/ContextBase && cp nodes/ContextBase/contextbase.* dist/nodes/ContextBase/",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint nodes credentials --ext .ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ContextBaseApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ContextBase/ContextBase.node.js"
    ]
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "contextbase",
    "memory",
    "ai",
    "agents",
    "llm",
    "long-term-memory"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "^2.6.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "postcss": ">=8.5.23 <9.0.0"
  },
  "engines": {
    "node": ">=20.15"
  }
}
