{
  "name": "contextbase-coding-agents",
  "version": "0.8.1",
  "description": "ContextBase long-term memory for coding agents; remote connection required.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "contextbase-coding-agents": "dist/installer.js",
    "contextbase-claude-hook": "dist/claude-hook.js",
    "contextbase-cursor-hook": "dist/cursor-hook.js",
    "contextbase-cursor-sessionstart-hook": "dist/cursor-sessionstart-hook.js",
    "contextbase-cursor-stop-hook": "dist/cursor-stop-hook.js",
    "contextbase-copilot-hook": "dist/copilot-hook.js",
    "contextbase-copilot-sessionstart-hook": "dist/copilot-sessionstart-hook.js",
    "contextbase-copilot-stop-hook": "dist/copilot-stop-hook.js",
    "contextbase-grok-hook": "dist/grok-hook.js",
    "contextbase-grok-sessionstart-hook": "dist/grok-sessionstart-hook.js",
    "contextbase-grok-stop-hook": "dist/grok-stop-hook.js",
    "contextbase-codex-hook": "dist/codex-hook.js",
    "contextbase-dcode-hook": "dist/dcode-hook.js",
    "contextbase-dcode-sessionstart-hook": "dist/dcode-sessionstart-hook.js",
    "contextbase-dcode-stop-hook": "dist/dcode-stop-hook.js",
    "contextbase-antigravity-hook": "dist/antigravity-hook.js",
    "contextbase-antigravity-statusline": "dist/antigravity-statusline.js",
    "contextbase-devin-hook": "dist/devin-hook.js",
    "contextbase-qwen-hook": "dist/qwen-hook.js",
    "contextbase-qwen-sessionstart-hook": "dist/qwen-sessionstart-hook.js",
    "contextbase-qwen-stop-hook": "dist/qwen-stop-hook.js",
    "contextbase-zcode-hook": "dist/zcode-hook.js",
    "contextbase-zcode-sessionstart-hook": "dist/zcode-sessionstart-hook.js",
    "contextbase-zcode-stop-hook": "dist/zcode-stop-hook.js",
    "contextbase-traecode-hook": "dist/traecode-hook.js",
    "contextbase-traecode-sessionstart-hook": "dist/traecode-sessionstart-hook.js",
    "contextbase-traecode-stop-hook": "dist/traecode-stop-hook.js",
    "contextbase-workbuddy-hook": "dist/workbuddy-hook.js",
    "contextbase-workbuddy-sessionstart-hook": "dist/workbuddy-sessionstart-hook.js",
    "contextbase-workbuddy-stop-hook": "dist/workbuddy-stop-hook.js",
    "contextbase-codebuddy-hook": "dist/codebuddy-hook.js",
    "contextbase-codebuddy-sessionstart-hook": "dist/codebuddy-sessionstart-hook.js",
    "contextbase-codebuddy-stop-hook": "dist/codebuddy-stop-hook.js",
    "contextbase-droid-hook": "dist/droid-hook.js",
    "contextbase-droid-sessionstart-hook": "dist/droid-sessionstart-hook.js",
    "contextbase-droid-stop-hook": "dist/droid-stop-hook.js",
    "contextbase-kimi-hook": "dist/kimi-hook.js",
    "contextbase-kimi-sessionstart-hook": "dist/kimi-sessionstart-hook.js",
    "contextbase-kimi-stop-hook": "dist/kimi-stop-hook.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsh": "./dist/dsh.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "skill",
    "dist",
    "index.js",
    "cordis.patch.yml",
    "plugin.json",
    "hooks"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "cline": {
    "plugins": [
      {
        "paths": [
          "./dist/cline.js"
        ],
        "capabilities": [
          "hooks"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "skill:build": "node scripts/build-skill.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run skill:build && npm run build",
    "test": "vitest run --exclude '**/*.e2e.test.ts'",
    "test:dcode-e2e": "npm run build && CONTEXTBASE_DCODE_E2E=1 vitest run src/dcode-plugin.e2e.test.ts",
    "test:harness-e2e": "npm run build && CONTEXTBASE_HARNESS_E2E=1 vitest run src/harness.e2e.test.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/plugin": "^1.18.9",
    "@opencode-ai/sdk": "^1.18.9",
    "@opencode/plugin": "^2.0.3",
    "@types/node": "^26.1.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.8.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": ">=0.25.0 <1.0.0",
    "fast-uri": ">=3.1.6 <4.0.0",
    "hono": ">=4.13.5 <5.0.0",
    "ip-address": ">=10.5.1 <11.0.0",
    "postcss": ">=8.5.23 <9.0.0",
    "vite": ">=6.4.3 <7.0.0"
  },
  "private": true
}
