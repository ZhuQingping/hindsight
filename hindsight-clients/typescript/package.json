{
  "name": "contextbase-client",
  "version": "1.1.0",
  "description": "TypeScript client for ContextBase - Semantic memory system with personality-driven thinking",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "generate": "npx @hey-api/openapi-ts",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:deno": "deno test --no-check --allow-env --allow-net --unstable-sloppy-imports --preload=tests/deno_setup.ts tests/main_operations.test.ts"
  },
  "keywords": [
    "contextbase",
    "memory",
    "api",
    "client",
    "typescript"
  ],
  "author": "ContextBase Team",
  "license": "MIT",
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "prettier": "3.7.4",
    "ts-jest": "^29.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "src",
    "generated",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
